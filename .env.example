# Local configuration. DATABASE_URL or DATABASE_URL_FILE is required.
APP_ENV=development
# Opt-in for local API documentation; forbidden in production.
DOCS_ENABLED=false
# Prefer generated local Compose secrets (see README).
# For an existing database, set exactly one of these outside version control:
# DATABASE_URL=
# DATABASE_URL_FILE=

# Required by the HTTP application; no signing-key fallback.
PUBLIC_ORIGIN=http://localhost:8080
# Generate a random 32-byte lowercase-hex key outside version control. Choose one:
# CSRF_SIGNING_KEY=
# CSRF_SIGNING_KEY_FILE=
